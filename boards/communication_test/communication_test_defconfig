# Communication Test Board (STM32F407VET6) configuration

# Basic
CONFIG_ARM_MPU=y
CONFIG_FPU=y

# Console / Serial
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# GPIO
CONFIG_GPIO=y

# Communication peripherals
CONFIG_I2C=y
CONFIG_SPI=y
CONFIG_CAN=y

# Sensor (BMI088 accel + gyro)
CONFIG_SENSOR=y
CONFIG_SENSOR_ASYNC_API=y
CONFIG_BMI08X=y

# ADC
CONFIG_ADC=y

# QDEC (TIM3/TIM4 encoder)
CONFIG_QDEC_STM32=y

# PWM (TIM1)
CONFIG_PWM=y

# USB (OTG FS)
CONFIG_USB_DEVICE_STACK_NEXT=y
# CONFIG_LOG=y
# CONFIG_USBD_LOG_LEVEL_DBG=y
# CONFIG_USBD_LOG_LEVEL_ERR=y

# WS2812 LED strip (via SPI3)
CONFIG_LED_STRIP=y
CONFIG_WS2812_STRIP_SPI=y
